# Lambda environment variables for {{ app.name }}
# Paste into the Lambda console. The file mtime is when it was generated.
# Terraform declares none of these and ignores the attribute, so the console is
# the only owner. All variables together must stay under Lambda's 4KB limit.

# The generated passwords are letters and digits only, so no percent-encoding
# is needed here. The three ssl paths are written at import time by
# app/database.py; keep them in step with DB_CERT_FILES there.
DATABASE_URL=postgresql+psycopg2://{{ app.pg_role }}:{{ app_passwords[app.name] }}@{{ vm_hostname }}:{{ pgbouncer_port }}/{{ app.pg_database }}?sslmode=verify-full&sslrootcert=/tmp/db-certs/server-ca.crt&sslcert=/tmp/db-certs/client.crt&sslkey=/tmp/db-certs/client.key

# PEMs with newlines escaped to \n, so every value stays on one line: the
# Lambda console's value field is single-line and a KEY=VALUE file cannot hold
# a raw PEM. app/database.py unescapes them. ECDSA P-256 keeps all three near
# 1.5KB; RSA-2048 would not fit inside the 4KB budget.
DB_SERVER_CA={{ server_ca_pem | trim | replace('\n', '\\n') }}
DB_CLIENT_CERT={{ client_certs[app.name] | trim | replace('\n', '\\n') }}
DB_CLIENT_KEY={{ client_keys[app.name] | trim | replace('\n', '\\n') }}

# rediss:// because the server listens on tls-port only. No username: redis
# authenticates with requirepass alone. The CA is the same file app/database.py
# writes for postgres, so it must already exist when the client connects.
REDIS_URL=rediss://:{{ redis_passwords[app.name] }}@{{ vm_hostname }}:{{ app.redis_port }}/0?ssl_cert_reqs=required&ssl_ca_certs=/tmp/db-certs/server-ca.crt&ssl_certfile=/tmp/db-certs/client.crt&ssl_keyfile=/tmp/db-certs/client.key

JWT_SECRET_KEY={{ jwt_secrets[app.name] }}
ENCODE_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
IS_PRODUCTION=True

CORS_ORIGINS=https://{{ app.domain }}
FRONTEND_REDIRECT_URL=https://{{ app.domain }}/callback
GOOGLE_CALLBACK_URI=https://{{ app.domain }}/api/auth/google/callback
S3_BUCKET_NAME={{ app.pdf_bucket }}

# AWS_REGION, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are injected by the
# Lambda runtime from the execution role. AWS_REGION is reserved and cannot be
# set here even if you wanted to.

# Supply these yourself from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
