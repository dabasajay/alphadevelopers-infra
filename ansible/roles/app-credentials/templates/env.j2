# Lambda environment variables for {{ app.name }}
# Paste into the Lambda console. The file mtime is when it was generated.
# Terraform declares none of these and ignores the attribute, so the console
# is the only owner. Total must stay under Lambda's 4KB limit for all vars.

DB_HOST={{ vm_hostname }}
DB_PORT={{ pgbouncer_port }}
DB_NAME={{ app.pg_database }}
DB_USER={{ app.pg_role }}
DB_PASSWORD={{ app_passwords[app.name] }}
DB_SSLMODE=verify-full

REDIS_HOST={{ vm_hostname }}
REDIS_PORT={{ app.redis_port }}
REDIS_PASSWORD={{ redis_passwords[app.name] }}

# PEM blobs, newlines included. ECDSA P-256 keeps all three near 1.5KB;
# RSA-2048 would not fit inside the 4KB budget.
DB_SERVER_CA={{ server_ca_pem }}
DB_CLIENT_CERT={{ client_certs[app.name] }}
DB_CLIENT_KEY={{ client_keys[app.name] }}
