port 0
tls-port 6379
tls-cert-file /certs/server.crt
tls-key-file /certs/server.key
# The client CA, not the server CA: this file is what incoming client
# certificates are verified against, mirroring pgbouncer's client_tls_ca_file.
tls-ca-cert-file /certs/client-ca.crt
# Redis is published to the internet. A password alone is one guessable secret;
# requiring a client certificate means an attacker needs the private key too.
tls-auth-clients yes
tls-protocols "TLSv1.2 TLSv1.3"

requirepass {{ redis_password }}
maxclients {{ app.redis_maxclients }}
maxmemory {{ app.redis_maxmemory }}
maxmemory-policy volatile-lru

# Cache only. No RDB snapshots, no AOF: nothing here is worth persisting.
save ""
appendonly no

# Reap sockets left by frozen or reaped Lambda containers.
timeout 300
tcp-keepalive 60
maxmemory-clients 5%

# Rename the commands that can wipe or reconfigure a shared instance.
rename-command FLUSHALL ""
rename-command FLUSHDB ""
rename-command CONFIG ""
